# Godot 4 generated cache
.godot/
*.tmp
*.log
.DS_Store
Thumbs.db

# Read-only external game-dev skill reference pack, installed locally
.agent-skills/

# Python test/QA bytecode is generated output, not game source.
__pycache__/
*.py[cod]
build/android/

# Godot 4.7 generates UID sidecars for headless test scripts on import.
# Test scripts are loaded by res:// path; only test-sidecar UIDs are ignored.
# Keep non-test .gd.uid resources versioned for stable scene references.
/tests/*.gd.uid
build
